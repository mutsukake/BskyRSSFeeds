# BlueSky RSS Feeds Configuration
bluesky_username = 'your-handle.bsky.social'
bluesky_password = 'your-app-password'

# Inoreader API credentials
inor_app_id = 'your-inoreader-client-id'
inor_app_key = 'your-inoreader-client-secret'
inor_redirect_url = 'http://localhost:5001/callback'
inor_oauth_init_server = 'http://localhost:5001'
inor_starred_url = 'https://www.inoreader.com/reader/api/0/stream/contents/user/-/state/com.google/starred'

# Filled in automatically by inor_init_auth.py / main.py - leave blank initially
inor_access_token=
inor_refresh_token=

# Database Settings (SQLite)
db_name = 'posted_ids.db'
table_name = 'posted'
